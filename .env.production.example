# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN - VOZSEGURA
# ============================================

# BASE DE DATOS (Railway MySQL)
DB_HOST=${MYSQLHOST}
DB_USER=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}
DB_NAME=${MYSQLDATABASE}
DB_PORT=${MYSQLPORT}

# JWT AUTHENTICATION
JWT_SECRET=CAMBIAR_ESTO_POR_UNA_CLAVE_SUPER_SEGURA_DE_64_CARACTERES
JWT_EXPIRES_IN=7d

# SERVIDOR
PORT=3000
NODE_ENV=production

# FRONTEND URL (para CORS)
FRONTEND_URL=https://tu-app.railway.app

# OPCIONALES
# MAX_FILE_SIZE=52428800
# UPLOAD_PATH=./uploads
