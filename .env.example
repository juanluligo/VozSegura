# ========================================
# CONFIGURACIÓN DE BASE DE DATOS MONGODB
# ========================================

MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/vozsegura

# ========================================
# CONFIGURACIÓN DE JWT
# ========================================

JWT_SECRET=tu_secreto_super_seguro_cambiar_en_produccion_2024
JWT_EXPIRE=7d

# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================

NODE_ENV=development
PORT=3000

# ========================================
# URLs DE FRONTEND (CORS)
# ========================================

FRONTEND_URL=http://localhost:5173
PRODUCTION_URL=https://tu-frontend.com

# ========================================
# CONFIGURACIÓN DE EMAIL (OPCIONAL)
# ========================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_password_o_app_password
# FROM_EMAIL=noreply@vozsegura.com
# FROM_NAME=VozSegura

# ========================================
# INSTRUCCIONES DE SETUP
# ========================================

# 1. IMPORTANTE: Obtén tu MONGODB_URI de MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# 2. Reemplaza usuario:contraseña con tus credenciales
# 3. Cambia JWT_SECRET por una cadena aleatoria segura
# 4. Para desarrollo: NODE_ENV=development | Para producción: NODE_ENV=production
# 5. Configura FRONTEND_URL según donde esté tu frontend
# 6. En producción, usa PRODUCTION_URL para validar CORS
